<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lqa_admin_panel.RetailersOrders">
        <div class="o_lqa_orders">
            <section class="o_lqa_orders__filters">
                <div class="o_lqa_orders__filters_head">
                    <div>
                        <h1>Ordenes</h1>
                        <span>Ordenes de todos los marketplaces, desde Madre.</span>
                    </div>
                    <div class="o_lqa_orders__filters_actions">
                        <button
                            type="button"
                            class="o_lqa_orders__ghost"
                            t-on-click="clearFilters"
                            t-att-disabled="!hasFilters"
                        >
                            Limpiar
                        </button>
                        <button type="button" class="o_lqa_orders__primary" t-on-click="applyFilters">
                            <i t-att-class="state.loading ? 'fa fa-spinner fa-spin' : 'fa fa-search'"/>
                            <t t-esc="state.loading ? 'Buscando...' : 'Buscar'"/>
                        </button>
                    </div>
                </div>

                <div class="o_lqa_orders__filters_grid">
                    <label class="is-wide">
                        <span>Buscar</span>
                        <input
                            type="text"
                            placeholder="Orden, cliente, documento o TLQV"
                            t-model="state.filters.search"
                            t-on-keyup="(ev) => ev.key === 'Enter' and this.applyFilters()"
                        />
                    </label>
                    <label>
                        <span>Marketplace</span>
                        <select t-model="state.filters.marketplace">
                            <option value="">Todos</option>
                            <option
                                t-foreach="state.options.marketplaces"
                                t-as="code"
                                t-key="code"
                                t-att-value="code"
                                t-esc="marketplaceLabel(code)"
                            />
                        </select>
                    </label>
                    <label>
                        <span>Desde</span>
                        <input type="date" t-model="state.filters.from"/>
                    </label>
                    <label>
                        <span>Hasta</span>
                        <input type="date" t-model="state.filters.to"/>
                    </label>
                    <label>
                        <span>Por pagina</span>
                        <select t-model.number="state.filters.limit">
                            <option
                                t-foreach="state.options.pageSizes"
                                t-as="size"
                                t-key="size"
                                t-att-value="size"
                                t-esc="size"
                            />
                        </select>
                    </label>
                </div>

                <div class="o_lqa_orders__chips">
                    <button
                        type="button"
                        t-att-class="!state.filters.persistenceStatus ? 'is-active' : ''"
                        t-on-click="() => this.setStatus('')"
                    >
                        Todos
                    </button>
                    <button
                        type="button"
                        t-foreach="state.options.statuses"
                        t-as="code"
                        t-key="code"
                        t-att-class="(state.filters.persistenceStatus === code ? 'is-active ' : '') + statusClass(code)"
                        t-on-click="() => this.setStatus(code)"
                        t-esc="statusLabel(code)"
                    />
                </div>
            </section>

            <section class="o_lqa_orders__results">
                <div class="o_lqa_orders__results_head">
                    <div>
                        <strong t-esc="formatNumber(state.pagination.total or 0)"/>
                        <span>ordenes encontradas</span>
                    </div>
                    <div class="o_lqa_orders__pager" t-if="state.pagination.total">
                        <span>
                            <t t-esc="formatNumber(state.pagination.from)"/>–<t t-esc="formatNumber(state.pagination.to)"/>
                            de <t t-esc="formatNumber(state.pagination.total)"/>
                        </span>
                        <button
                            type="button"
                            t-on-click="previousPage"
                            t-att-disabled="!state.pagination.hasPrevious or state.loading"
                        >
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button
                            type="button"
                            t-on-click="nextPage"
                            t-att-disabled="!state.pagination.hasNext or state.loading"
                        >
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                </div>

                <div t-if="state.loading" class="o_lqa_orders__empty">
                    <i class="fa fa-circle-o-notch fa-spin"/>
                    <strong>Consultando Madre</strong>
                </div>

                <div t-elif="!state.items.length" class="o_lqa_orders__empty">
                    <i class="fa fa-inbox"/>
                    <strong>Sin ordenes</strong>
                    <span>Probá ampliar el rango de fechas o limpiar los filtros.</span>
                </div>

                <div t-else="" class="o_lqa_orders__table_wrap">
                    <table class="o_lqa_orders__table">
                        <thead>
                            <tr>
                                <th>Marketplace</th>
                                <th>Orden</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th class="is-right">Importe</th>
                                <th class="is-center">Items</th>
                                <th>Estado</th>
                                <th>TLQV</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr
                                t-foreach="state.items"
                                t-as="order"
                                t-key="order.uniqueKey"
                                t-on-click="() => this.openOrder(order)"
                            >
                                <td>
                                    <span t-att-class="'o_lqa_orders__mk is-' + order.marketplace"
                                        t-esc="marketplaceLabel(order.marketplace)"/>
                                </td>
                                <td>
                                    <strong t-esc="order.externalOrderId || '-'"/>
                                    <small t-if="order.externalSuborderId" t-esc="order.externalSuborderId"/>
                                </td>
                                <td t-esc="formatDateTime(order.purchaseDate)"/>
                                <td>
                                    <strong t-esc="order.customerName || '-'"/>
                                    <small t-if="order.shippingProvince" t-esc="order.shippingProvince"/>
                                </td>
                                <td class="is-right">
                                    <strong t-esc="formatCurrency(order.amountTotal, order.currency)"/>
                                </td>
                                <td class="is-center" t-esc="formatNumber(order.itemsQuantity)"/>
                                <td>
                                    <span t-att-class="'o_lqa_orders__pill ' + statusClass(order.persistenceStatus)"
                                        t-esc="statusLabel(order.persistenceStatus)"/>
                                    <small t-if="order.status" t-esc="order.status"/>
                                </td>
                                <td>
                                    <strong t-if="order.floxuCode" t-esc="order.floxuCode"/>
                                    <span t-else="" class="o_lqa_orders__muted">-</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <div t-if="state.selected" class="o_lqa_orders__modal" t-on-click="closeOrder">
                <div class="o_lqa_orders__modal_panel" t-on-click.stop="() => {}">
                    <header>
                        <div>
                            <span t-att-class="'o_lqa_orders__mk is-' + state.selected.marketplace"
                                t-esc="marketplaceLabel(state.selected.marketplace)"/>
                            <h2 t-esc="state.selected.externalOrderId || state.selected.uniqueKey"/>
                            <small t-if="state.selected.externalSuborderId" t-esc="state.selected.externalSuborderId"/>
                        </div>
                        <div class="o_lqa_orders__modal_head_right">
                            <span t-att-class="'o_lqa_orders__pill ' + statusClass(state.selected.persistenceStatus)"
                                t-esc="statusLabel(state.selected.persistenceStatus)"/>
                            <button type="button" t-on-click="closeOrder" aria-label="Cerrar">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </header>

                    <div t-if="state.loadingDetail" class="o_lqa_orders__modal_loading">
                        <i class="fa fa-circle-o-notch fa-spin"/>
                        Cargando detalle
                    </div>

                    <div class="o_lqa_orders__metrics">
                        <div>
                            <small>Importe</small>
                            <strong t-esc="formatCurrency(state.selected.amountTotal, state.selected.currency)"/>
                        </div>
                        <div>
                            <small>Items</small>
                            <strong t-esc="formatNumber(state.selected.itemsQuantity)"/>
                        </div>
                        <div>
                            <small>Moneda</small>
                            <strong t-esc="state.selected.currency"/>
                        </div>
                        <div>
                            <small>Fecha de compra</small>
                            <strong t-esc="formatDateTime(state.selected.purchaseDate)"/>
                        </div>
                    </div>

                    <div class="o_lqa_orders__groups">
                        <section t-foreach="selectedRows" t-as="group" t-key="group.title">
                            <h3>
                                <i t-att-class="'fa ' + group.icon"/>
                                <t t-esc="group.title"/>
                            </h3>
                            <dl>
                                <t t-foreach="group.rows" t-as="row" t-key="row[0]">
                                    <dt t-esc="row[0]"/>
                                    <dd t-att-class="row[2] ? 'is-mono' : ''">
                                        <span t-esc="row[1] || '-'"/>
                                        <button
                                            t-if="row[2] and row[1]"
                                            type="button"
                                            class="o_lqa_orders__copy"
                                            t-att-title="'Copiar ' + row[0]"
                                            t-on-click="() => this.copy(row[1], row[0] + ' copiado')"
                                        >
                                            <i class="fa fa-clone"/>
                                        </button>
                                    </dd>
                                </t>
                            </dl>
                        </section>
                    </div>

                    <div t-if="state.selected.lastError" class="o_lqa_orders__error">
                        <strong>Ultimo error</strong>
                        <span t-esc="state.selected.lastError"/>
                    </div>

                    <details t-if="selectedPayload" class="o_lqa_orders__disclosure">
                        <summary>
                            Ver payload crudo
                            <button
                                type="button"
                                t-on-click.stop.prevent="() => this.copy(selectedPayload, 'Payload copiado')"
                            >
                                <i class="fa fa-clone"/>
                                Copiar
                            </button>
                        </summary>
                        <pre t-esc="selectedPayload"/>
                    </details>
                </div>
            </div>
        </div>
    </t>
</templates>
