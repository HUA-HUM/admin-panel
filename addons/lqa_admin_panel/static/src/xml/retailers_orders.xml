<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lqa_admin_panel.RetailersOrders">
        <div class="o_lqa_orders">
            <header class="o_lqa_orders__header">
                <div>
                    <p>Retailers / Frávega</p>
                    <h1>Órdenes VTEX</h1>
                    <span>Consulta temporal de órdenes y datos de facturación de Frávega.</span>
                </div>
                <div class="o_lqa_orders__actions">
                    <span class="o_lqa_orders_live"><i class="fa fa-circle"/> Datos en vivo</span>
                    <button type="button" class="btn btn-secondary" t-att-disabled="state.loading" t-on-click="() => this.loadOrders(state.orders.pagination.page)">
                        <i t-att-class="state.loading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"/>
                        Actualizar
                    </button>
                </div>
            </header>

            <section class="o_lqa_orders_notice">
                <i class="fa fa-info-circle"/>
                <div>
                    <strong>Vista temporal de Frávega</strong>
                    <span>El listado se consulta directamente en Marketplace API. Abrí una orden para obtener su detalle de facturación.</span>
                </div>
            </section>

            <section class="o_lqa_orders_summary">
                <article class="o_lqa_orders_summary__main">
                    <small>Total de órdenes</small>
                    <strong t-esc="formatNumber(state.orders.pagination.total)"/>
                    <span>Disponibles en VTEX</span>
                </article>
                <article>
                    <small>Página actual</small>
                    <strong><t t-esc="formatNumber(state.orders.pagination.page)"/>/<t t-esc="formatNumber(state.orders.pagination.totalPages)"/></strong>
                    <span><t t-esc="formatNumber(state.orders.pagination.from)"/>–<t t-esc="formatNumber(state.orders.pagination.to)"/> visibles</span>
                </article>
                <article class="is-success">
                    <small>Listas para preparar</small>
                    <strong t-esc="formatNumber(pageStats.ready)"/>
                    <span>En esta página</span>
                </article>
                <article class="is-danger">
                    <small>Canceladas</small>
                    <strong t-esc="formatNumber(pageStats.canceled)"/>
                    <span>En esta página</span>
                </article>
                <article>
                    <small>Valor visible</small>
                    <strong class="is-money" t-esc="formatCurrency(pageStats.value)"/>
                    <span>Suma de la página</span>
                </article>
            </section>

            <section class="o_lqa_orders_list">
                <div class="o_lqa_orders_list__head">
                    <div>
                        <h2>Órdenes de Frávega</h2>
                        <span>Seleccioná una fila para consultar facturación, cliente, pago y envío.</span>
                    </div>
                    <label class="o_lqa_orders_search">
                        <i class="fa fa-search"/>
                        <input type="search" placeholder="Buscar en esta página" t-model="state.search"/>
                    </label>
                </div>

                <div t-if="state.loading" class="o_lqa_orders_loading">
                    <span/>
                    Consultando órdenes de Frávega...
                </div>
                <div t-elif="!visibleOrders.length" class="o_lqa_orders_empty">
                    No hay órdenes que coincidan con la búsqueda.
                </div>
                <div t-else="" class="o_lqa_orders_table_wrap">
                    <table class="o_lqa_orders_table">
                        <thead>
                            <tr>
                                <th>Orden</th>
                                <th>Estado</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Unidades</th>
                                <th>Total</th>
                                <th>Entrega estimada</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="visibleOrders" t-as="order" t-key="order.key" t-on-click="() => this.openOrder(order)">
                                <td>
                                    <strong t-esc="order.id"/>
                                    <small>Secuencia <t t-esc="order.sequence || '-'"/></small>
                                </td>
                                <td><span t-att-class="'o_lqa_orders_badge ' + statusClass(order.status)" t-esc="statusLabel(order.status, order.statusDescription)"/></td>
                                <td t-esc="order.clientName || '-'"/>
                                <td t-esc="formatDateTime(order.createdAt)"/>
                                <td t-esc="formatNumber(order.totalItems)"/>
                                <td><strong t-esc="formatCurrency(order.total)"/></td>
                                <td t-esc="formatDateTime(order.shippingEstimatedAt)"/>
                                <td><button type="button" class="o_lqa_orders_open" title="Ver detalle"><i class="fa fa-chevron-right"/></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <footer class="o_lqa_orders_pagination">
                    <span>Página <strong t-esc="state.orders.pagination.page"/> de <strong t-esc="state.orders.pagination.totalPages"/></span>
                    <div>
                        <button type="button" class="btn btn-secondary" t-att-disabled="state.loading || !state.orders.pagination.hasPrevious" t-on-click="previousPage"><i class="fa fa-chevron-left"/></button>
                        <button type="button" t-foreach="visiblePages" t-as="page" t-key="page" t-att-class="page === state.orders.pagination.page ? 'is-active' : ''" t-on-click="() => this.loadOrders(page)" t-esc="page"/>
                        <button type="button" class="btn btn-secondary" t-att-disabled="state.loading || !state.orders.pagination.hasNext" t-on-click="nextPage"><i class="fa fa-chevron-right"/></button>
                    </div>
                </footer>
            </section>

            <div t-if="state.selectedOrderId" class="o_lqa_order_drawer_backdrop">
                <aside class="o_lqa_order_drawer">
                    <header class="o_lqa_order_drawer__head">
                        <div>
                            <p>Detalle de la orden</p>
                            <h2 t-esc="state.selectedOrderId"/>
                        </div>
                        <button type="button" title="Cerrar" t-on-click="closeOrder"><i class="fa fa-times"/></button>
                    </header>

                    <div t-if="state.loadingDetail" class="o_lqa_order_drawer__loading">
                        <span/>
                        <strong>Consultando facturación...</strong>
                        <small>Obteniendo cliente, pago, logística e invoices.</small>
                    </div>
                    <div t-elif="state.detailError" class="o_lqa_order_drawer__error">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong>No se pudo cargar el detalle</strong>
                        <span t-esc="state.detailError"/>
                    </div>
                    <div t-elif="state.detail" class="o_lqa_order_drawer__body">
                        <section class="o_lqa_order_detail_hero">
                            <span t-att-class="'o_lqa_orders_badge ' + statusClass(state.detail.status)" t-esc="statusLabel(state.detail.status)"/>
                            <strong t-esc="formatCurrency(state.detail.total)"/>
                            <small>Creada <t t-esc="formatDateTime(state.detail.createdAt)"/> · Secuencia <t t-esc="state.detail.sequence || '-'"/></small>
                        </section>

                        <section class="o_lqa_order_detail_section">
                            <div class="o_lqa_order_detail_section__title"><i class="fa fa-user"/><h3>Cliente</h3></div>
                            <dl class="o_lqa_order_detail_grid">
                                <div><dt>Nombre</dt><dd t-esc="state.detail.client.name || '-'"/></div>
                                <div><dt>Documento</dt><dd><t t-esc="state.detail.client.documentType || ''"/> <t t-esc="state.detail.client.document || '-'"/></dd></div>
                                <div><dt>Teléfono</dt><dd t-esc="state.detail.client.phone || '-'"/></div>
                                <div><dt>Email</dt><dd t-esc="state.detail.client.email || '-'"/></div>
                            </dl>
                        </section>

                        <section class="o_lqa_order_detail_section">
                            <div class="o_lqa_order_detail_section__title"><i class="fa fa-map-marker"/><h3>Entrega</h3></div>
                            <p class="o_lqa_order_address" t-esc="addressLine(state.detail.address)"/>
                            <article t-foreach="state.detail.logistics" t-as="logistic" t-key="logistic_index" class="o_lqa_order_logistic">
                                <div><strong t-esc="logistic.service || 'Envío'"/><span t-esc="logistic.company || '-'"/></div>
                                <small>Item <t t-esc="logistic.itemId || '-'"/> · Estimada <t t-esc="formatDateTime(logistic.estimatedAt)"/></small>
                            </article>
                            <p t-if="!state.detail.logistics.length" class="o_lqa_order_muted">Sin información logística.</p>
                        </section>

                        <section class="o_lqa_order_detail_section">
                            <div class="o_lqa_order_detail_section__title"><i class="fa fa-credit-card"/><h3>Pago</h3></div>
                            <article t-foreach="state.detail.payments" t-as="payment" t-key="payment_index" class="o_lqa_order_payment">
                                <div><strong t-esc="payment.method || payment.group || 'Pago'"/><span t-esc="formatCurrency(payment.value)"/></div>
                                <small><t t-esc="formatNumber(payment.installments)"/> cuotas · <t t-esc="payment.acquirer || '-'"/> · Auth <t t-esc="payment.authorization || '-'"/></small>
                            </article>
                            <p t-if="!state.detail.payments.length" class="o_lqa_order_muted">Sin información de pago.</p>
                        </section>

                        <section class="o_lqa_order_detail_counts">
                            <article><small>Invoices</small><strong t-esc="formatNumber(state.detail.invoices.length)"/></article>
                            <article><small>Paquetes</small><strong t-esc="formatNumber(state.detail.packages.length)"/></article>
                        </section>

                        <section class="o_lqa_order_detail_raw">
                            <button type="button" t-on-click="() => this.state.showRaw = !this.state.showRaw">
                                <span><i class="fa fa-code"/> Respuesta técnica completa</span>
                                <i t-att-class="state.showRaw ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"/>
                            </button>
                            <pre t-if="state.showRaw" t-esc="state.detail.rawJson"/>
                        </section>
                    </div>
                </aside>
            </div>
        </div>
    </t>
</templates>
