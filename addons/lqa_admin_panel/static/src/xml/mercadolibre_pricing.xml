<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lqa_admin_panel.MercadolibrePricing">
        <div class="o_lqa_meli_pricing">
            <header class="o_lqa_meli_pricing__header">
                <div>
                    <p>MercadoLibre</p>
                    <h1>Pricing</h1>
                    <span>Composicion masiva de precio, rentabilidad y precio sugerido.</span>
                </div>
                <img
                    src="/lqa_admin_panel/static/src/img/mercadolibre-logo.png?v=2"
                    alt="Mercado Libre"
                />
            </header>

            <section class="o_lqa_meli_pricing_workspace">
                <article class="o_lqa_meli_pricing_input o_lqa_meli_pricing_folder_import">
                    <div class="o_lqa_meli_pricing_section_head">
                        <div>
                            <p class="o_lqa_meli_pricing_eyebrow">Ejecución masiva</p>
                            <h2>Procesar una selección completa</h2>
                            <span>
                                Un solo proceso visible, lotes seguros en segundo plano y un Excel consolidado.
                            </span>
                        </div>
                        <span class="o_lqa_meli_pricing_secure_badge">
                            <i class="fa fa-shield"/> Proceso protegido
                        </span>
                    </div>
                    <div class="o_lqa_meli_pricing_folder_tools">
                        <select class="form-select" t-model="state.selectedFolderId">
                            <option value="">Elegir carpeta</option>
                            <option
                                t-foreach="state.selectionFolders"
                                t-as="folder"
                                t-key="folder.id"
                                t-att-value="folder.id"
                            >
                                <t t-esc="folder.name"/> ·
                                <t t-esc="formatNumber(folder.productCount)"/> publicaciones
                            </option>
                        </select>
                        <button
                            type="button"
                            class="btn btn-primary"
                            t-att-disabled="!state.selectedFolderId || state.startingFolderImport || isFolderImportRunning"
                            t-on-click="startFolderImport"
                        >
                            <t t-if="state.startingFolderImport">Preparando...</t>
                            <t t-else="">Iniciar procesamiento</t>
                        </button>
                    </div>
                    <div t-if="state.folderImport" t-att-class="'o_lqa_meli_pricing_import_status is-' + state.folderImport.pricingState">
                        <div class="o_lqa_meli_pricing_import_summary">
                            <div class="o_lqa_meli_pricing_import_title">
                                <span class="o_lqa_meli_pricing_import_icon"><i class="fa fa-folder-open"/></span>
                                <div>
                                    <strong t-esc="state.folderImport.folderName"/>
                                    <span t-esc="stateLabel(state.folderImport.pricingState)"/>
                                </div>
                            </div>
                            <div class="o_lqa_meli_pricing_import_actions">
                                <button
                                    t-if="state.folderImport.failedJobs"
                                    type="button"
                                    class="btn btn-secondary"
                                    t-att-disabled="state.retryingFolderImport"
                                    t-on-click="retryFolderImport"
                                >
                                    <i class="fa fa-refresh"/>
                                    <t t-if="state.retryingFolderImport">Reintentando...</t>
                                    <t t-else="">Reintentar errores</t>
                                </button>
                                <button
                                    t-if="state.folderImport.canExport &amp;&amp; ['idle', 'failed'].includes(state.folderImport.exportState)"
                                    type="button"
                                    class="btn btn-primary"
                                    t-att-disabled="state.generatingFolderExcel"
                                    t-on-click="generateFolderExcel"
                                >
                                    <i class="fa fa-file-excel-o"/>
                                    <t t-if="state.generatingFolderExcel">Preparando...</t>
                                    <t t-else="">Generar Excel único</t>
                                </button>
                                <button
                                    t-elif="['queued', 'running'].includes(state.folderImport.exportState)"
                                    type="button"
                                    class="btn btn-secondary"
                                    disabled="disabled"
                                >
                                    <i class="fa fa-circle-o-notch fa-spin"/> Generando Excel...
                                </button>
                                <button
                                    t-elif="state.folderImport.exportState === 'done'"
                                    type="button"
                                    class="btn btn-primary"
                                    t-on-click="downloadFolderExcel"
                                >
                                    <i class="fa fa-download"/> Descargar Excel consolidado
                                </button>
                            </div>
                        </div>
                        <div class="o_lqa_meli_pricing_import_kpis">
                            <article><small>Publicaciones</small><strong t-esc="formatNumber(state.folderImport.valid)"/></article>
                            <article><small>Procesadas</small><strong t-esc="formatNumber(state.folderImport.success)"/></article>
                            <article><small>En proceso</small><strong t-esc="formatNumber(state.folderImport.pendingJobs)"/></article>
                            <article class="is-error"><small>Con error</small><strong t-esc="formatNumber(state.folderImport.failed)"/></article>
                        </div>
                        <div class="o_lqa_meli_pricing_import_progress_label">
                            <span>Avance del procesamiento</span>
                            <strong><t t-esc="folderPricingProgress"/>%</strong>
                        </div>
                        <div class="o_lqa_meli_pricing_import_track">
                            <span t-att-style="'width:' + folderPricingProgress + '%'"/>
                        </div>
                        <small t-if="state.folderImport.error" class="o_lqa_meli_pricing_import_error" t-esc="state.folderImport.error"/>
                        <small t-if="state.folderImport.exportError" class="o_lqa_meli_pricing_import_error" t-esc="state.folderImport.exportError"/>
                    </div>
                </article>

                <article class="o_lqa_meli_pricing_input">
                    <div class="o_lqa_meli_pricing_section_head">
                        <div>
                            <h2>Cargar CSV</h2>
                            <span>Hasta 5.000 filas. Columnas: mla, sku, tipo_publicacion, precio, categoria.</span>
                        </div>
                        <span t-if="state.csvName" class="o_lqa_meli_pricing_file">
                            <i class="fa fa-file-text-o"/>
                            <t t-esc="state.csvName"/>
                        </span>
                    </div>

                    <div class="o_lqa_meli_pricing_upload">
                        <label class="btn btn-secondary">
                            <i class="fa fa-upload"/>
                            Seleccionar CSV
                            <input
                                type="file"
                                accept=".csv,text/csv,text/plain"
                                t-on-change="onCsvSelected"
                            />
                        </label>
                        <button
                            type="button"
                            class="btn btn-secondary"
                            t-att-disabled="!state.csvContent"
                            t-on-click="clearCsv"
                        >
                            Limpiar
                        </button>
                        <button
                            type="button"
                            class="btn btn-primary"
                            t-att-disabled="!state.csvContent || state.creatingCsv"
                            t-on-click="submitCsv"
                        >
                            <t t-if="state.creatingCsv">Creando...</t>
                            <t t-else="">Procesar CSV</t>
                        </button>
                    </div>
                </article>

                <article class="o_lqa_meli_pricing_input">
                    <div class="o_lqa_meli_pricing_section_head">
                        <div>
                            <h2>Carga manual</h2>
                            <span>CSV con encabezados o JSON array.</span>
                        </div>
                    </div>
                    <textarea
                        class="form-control"
                        rows="8"
                        t-model="state.manualText"
                    />
                    <div class="o_lqa_meli_pricing_input_actions">
                        <button
                            type="button"
                            class="btn btn-primary"
                            t-att-disabled="state.creatingManual"
                            t-on-click="submitManual"
                        >
                            <t t-if="state.creatingManual">Creando...</t>
                            <t t-else="">Procesar manual</t>
                        </button>
                    </div>
                </article>
            </section>

            <section class="o_lqa_meli_pricing_jobs">
                <aside class="o_lqa_meli_pricing_jobs__list">
                    <div class="o_lqa_meli_pricing_section_head">
                        <div>
                            <h2>Procesos individuales</h2>
                            <span>
                                <t t-esc="formatNumber(state.jobs.length)"/>
                                recientes
                            </span>
                        </div>
                        <button
                            type="button"
                            class="btn btn-secondary"
                            t-on-click="() => this.loadJobs()"
                        >
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>

                    <div t-if="state.loadingJobs" class="o_lqa_meli_pricing_empty">
                        Cargando jobs...
                    </div>
                    <div t-elif="!state.jobs.length" class="o_lqa_meli_pricing_empty">
                        Todavía no hay cargas CSV o manuales.
                    </div>
                    <div t-else="" class="o_lqa_meli_pricing_job_list">
                        <button
                            type="button"
                            t-foreach="state.jobs"
                            t-as="job"
                            t-key="job.id"
                            t-att-class="isSelectedJob(job) ? 'is-active' : ''"
                            t-on-click="() => this.loadJob(job.id)"
                        >
                            <div>
                                <strong t-esc="job.name"/>
                                <span
                                    t-att-class="'o_lqa_meli_pricing_status is-' + job.state"
                                    t-esc="stateLabel(job.state)"
                                />
                            </div>
                            <small>
                                <t t-esc="formatNumber(job.inputCount)"/>
                                filas -
                                <t t-esc="formatDateTime(job.createdAt)"/>
                            </small>
                        </button>
                    </div>
                </aside>

                <article class="o_lqa_meli_pricing_detail">
                    <div t-if="!state.selectedJob" class="o_lqa_meli_pricing_empty is-large">
                        Selecciona un job para ver el resultado.
                    </div>
                    <t t-else="">
                        <div class="o_lqa_meli_pricing_detail__head">
                            <div>
                                <p>Job #<t t-esc="state.selectedJob.id"/></p>
                                <h2 t-esc="state.selectedJob.name"/>
                                <span>
                                    Creado por
                                    <strong t-esc="state.selectedJob.userName"/>
                                    -
                                    <strong t-esc="formatDateTime(state.selectedJob.createdAt)"/>
                                </span>
                            </div>
                            <div class="o_lqa_meli_pricing_detail__actions">
                                <button
                                    t-if="state.selectedJob.state === 'failed'"
                                    type="button"
                                    class="btn btn-secondary"
                                    t-att-disabled="isRetryingJob(state.selectedJob)"
                                    t-on-click="() => this.retryJob(state.selectedJob)"
                                >
                                    <i class="fa fa-refresh"/>
                                    <t t-if="isRetryingJob(state.selectedJob)">Reintentando...</t>
                                    <t t-else="">Reintentar</t>
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    t-att-disabled="!canDownload(state.selectedJob) || isDownloading(state.selectedJob)"
                                    t-on-click="() => this.downloadJobXlsx(state.selectedJob)"
                                >
                                    <i class="fa fa-download"/>
                                    <t t-if="isDownloading(state.selectedJob)">Descargando...</t>
                                    <t t-else="">Descargar Excel</t>
                                </button>
                            </div>
                        </div>

                        <div class="o_lqa_meli_pricing_stats">
                            <article>
                                <small>Estado</small>
                                <strong t-esc="stateLabel(state.selectedJob.state)"/>
                            </article>
                            <article>
                                <small>Filas</small>
                                <strong t-esc="formatNumber(state.selectedJob.inputCount)"/>
                            </article>
                            <article>
                                <small>Listas</small>
                                <strong t-esc="formatNumber(state.selectedJob.successCount)"/>
                            </article>
                            <article>
                                <small>Errores</small>
                                <strong t-esc="formatNumber(state.selectedJob.failedCount)"/>
                            </article>
                        </div>

                        <div
                            t-if="state.selectedJob.errorMessage"
                            class="o_lqa_meli_pricing_error"
                            t-esc="state.selectedJob.errorMessage"
                        />

                        <div t-if="state.loadingJob" class="o_lqa_meli_pricing_empty">
                            Cargando detalle...
                        </div>
                        <div t-elif="!state.selectedJob.lines || !state.selectedJob.lines.length" class="o_lqa_meli_pricing_empty">
                            Todavia no hay detalle disponible.
                        </div>
                        <div t-else="" class="o_lqa_meli_pricing_table_wrap">
                            <div class="o_lqa_meli_pricing_table_toolbar">
                                <span>
                                    Filas <strong t-esc="formatNumber(state.selectedJob.linePagination.from)"/>–<strong t-esc="formatNumber(state.selectedJob.linePagination.to)"/>
                                    de <strong t-esc="formatNumber(state.selectedJob.linePagination.total)"/>
                                </span>
                                <div>
                                    <button type="button" class="btn btn-secondary" t-att-disabled="!state.selectedJob.linePagination.hasPrevious" t-on-click="previousJobLines">
                                        <i class="fa fa-chevron-left"/> Anterior
                                    </button>
                                    <button type="button" class="btn btn-secondary" t-att-disabled="!state.selectedJob.linePagination.hasNext" t-on-click="nextJobLines">
                                        Siguiente <i class="fa fa-chevron-right"/>
                                    </button>
                                </div>
                            </div>
                            <table class="o_lqa_meli_pricing_table">
                                <thead>
                                    <tr>
                                        <th>MLA</th>
                                        <th>SKU</th>
                                        <th>Tipo</th>
                                        <th>Precio venta</th>
                                        <th>Precio sugerido</th>
                                        <th>Profit</th>
                                        <th>Margen</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr
                                        t-foreach="state.selectedJob.lines"
                                        t-as="line"
                                        t-key="line.id"
                                    >
                                        <td>
                                            <strong t-esc="line.mla"/>
                                        </td>
                                        <td t-esc="line.sku"/>
                                        <td t-esc="line.publicationType"/>
                                        <td t-esc="formatCurrency(line.salePrice)"/>
                                        <td t-esc="formatCurrency(line.suggestedPrice)"/>
                                        <td t-esc="formatCurrency(line.operatingProfit)"/>
                                        <td t-esc="line.operatingProfitPercent || '-'"/>
                                        <td>
                                            <span
                                                t-att-class="'o_lqa_meli_pricing_status is-' + line.state"
                                                t-esc="stateLabel(line.state)"
                                            />
                                            <small t-if="line.errorMessage" t-esc="line.errorMessage"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </article>
            </section>
        </div>
    </t>
</templates>
