<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lqa_admin_panel.Retailers">
        <div class="o_lqa_retailers">
            <header class="o_lqa_retailers__header">
                <div>
                    <p>Retailers</p>
                    <h1 t-if="showDashboard">Dashboard</h1>
                    <h1 t-elif="showMarketplaces">Marketplaces</h1>
                    <h1 t-else="" t-esc="selectedMarketplace.name"/>
                    <span t-if="showDashboard">Resumen operativo de retailers y ordenes recientes.</span>
                    <span t-elif="showMarketplaces">Canales retail separados por productos, imports y status.</span>
                    <span t-else="" t-esc="selectedMarketplace.description"/>
                </div>
                <div class="o_lqa_retailers__actions">
                    <button
                        t-if="showDashboard"
                        type="button"
                        class="btn btn-secondary"
                        t-att-disabled="state.loadingDashboard"
                        t-on-click="refreshDashboard"
                    >
                        <i class="fa fa-refresh"/>
                        Actualizar
                    </button>
                    <button
                        t-if="showMarketplaceDetail"
                        type="button"
                        class="btn btn-secondary"
                        t-on-click="backToMarketplaces"
                    >
                        <i class="fa fa-arrow-left"/>
                        Volver
                    </button>
                    <button
                        t-if="showMarketplaceDetail"
                        type="button"
                        class="btn btn-secondary"
                        t-att-disabled="state.loadingProducts || state.loadingImports || state.loadingStatus"
                        t-on-click="refreshCurrent"
                    >
                        <i class="fa fa-refresh"/>
                        Actualizar
                    </button>
                </div>
            </header>

            <section t-if="showDashboard" class="o_lqa_retailers_dashboard">
                <article class="o_lqa_retailers_kpi is-main">
                    <small>Ordenes ultimas 24h</small>
                    <strong t-if="!state.loadingDashboard" t-esc="formatNumber(state.dashboardOrders.total || 0)"/>
                    <strong t-else="">...</strong>
                    <span>Fravega, Megatone y OnCity</span>
                </article>
                <article
                    class="o_lqa_retailers_kpi"
                    t-foreach="dashboardMarketplaceBreakdown"
                    t-as="marketplace"
                    t-key="marketplace.id"
                >
                    <small t-esc="marketplace.name"/>
                    <strong t-if="!state.loadingDashboard" t-esc="formatNumber(marketplace.total)"/>
                    <strong t-else="">...</strong>
                    <span>ordenes</span>
                </article>
                <article class="o_lqa_retailers_kpi">
                    <small>Errores</small>
                    <strong t-if="!state.loadingDashboard" t-esc="formatNumber(dashboardErrorsCount)"/>
                    <strong t-else="">...</strong>
                    <span>respuestas del servicio</span>
                </article>
                <div t-if="state.dashboardError" class="o_lqa_retailers_dashboard_error">
                    <i class="fa fa-exclamation-triangle"/>
                    <span t-esc="state.dashboardError"/>
                </div>
            </section>

            <section t-if="showMarketplaces" class="o_lqa_retailers_grid">
                <button
                    type="button"
                    t-foreach="state.marketplaces"
                    t-as="marketplace"
                    t-key="marketplace.id"
                    t-att-class="'o_lqa_retailer_card is-' + marketplace.accent"
                    t-on-click="() => this.openMarketplace(marketplace)"
                >
                    <div class="o_lqa_retailer_card__brand">
                        <img t-att-src="marketplace.logo" t-att-alt="marketplace.name"/>
                    </div>
                    <div class="o_lqa_retailer_card__body">
                        <small t-esc="marketplace.subtitle"/>
                        <h2 t-esc="marketplace.name"/>
                        <p t-esc="marketplace.description"/>
                        <div class="o_lqa_retailer_card__tabs">
                            <span>Products</span>
                            <span>Imports</span>
                            <span>Status</span>
                        </div>
                    </div>
                </button>
            </section>

<section t-if="showMarketplaceDetail" class="o_lqa_retailers_detail">
                <div t-att-class="'o_lqa_retailers_detail__brand is-' + selectedMarketplace.accent">
                    <img t-att-src="selectedMarketplace.logo" t-att-alt="selectedMarketplace.name"/>
                    <small>
                        /admin/marketplace/<t t-esc="selectedMarketplace.id"/>
                    </small>
                </div>

                <nav class="o_lqa_retailers_tabs">
                    <button
                        type="button"
                        t-att-class="state.activeTab === 'products' ? 'is-active' : ''"
                        t-on-click="() => this.setTab('products')"
                    >
                        Products
                    </button>
                    <button
                        type="button"
                        t-att-class="state.activeTab === 'imports' ? 'is-active' : ''"
                        t-on-click="() => this.setTab('imports')"
                    >
                        Imports
                    </button>
                    <button
                        type="button"
                        t-att-class="state.activeTab === 'status' ? 'is-active' : ''"
                        t-on-click="() => this.setTab('status')"
                    >
                        Status
                    </button>
                </nav>

                <section t-if="state.activeTab === 'products'" class="o_lqa_retailers_panel">
                    <form class="o_lqa_retailers_toolbar" t-on-submit.prevent="applyProductFilters">
                        <label class="o_lqa_retailers_search">
                            <i class="fa fa-search"/>
                            <input
                                type="search"
                                placeholder="Buscar SKU"
                                t-model="state.productFilters.sku"
                            />
                        </label>
                        <select class="form-select" t-model="state.productFilters.status">
                            <option value="">Todos los estados</option>
                            <option
                                t-foreach="statusOptions"
                                t-as="option"
                                t-key="option.status"
                                t-att-value="option.status"
                            >
                                <t t-esc="statusLabel(option.status)"/>
                                (<t t-esc="formatNumber(option.total)"/>)
                            </option>
                        </select>
                        <select class="form-select" t-model="state.productFilters.limit">
                            <option value="10">10 por pagina</option>
                            <option value="25">25 por pagina</option>
                            <option value="50">50 por pagina</option>
                        </select>
                        <button type="submit" class="btn btn-primary">
                            Aplicar
                        </button>
                    </form>

                    <div class="o_lqa_retailers_status_summary" t-if="statusOptions.length">
                        <button
                            type="button"
                            t-att-class="!state.productFilters.status ? 'is-active' : ''"
                            t-on-click="() => this.setProductStatus('')"
                        >
                            <span>Todos</span>
                            <strong t-esc="formatNumber(state.products.summary.total || state.products.pagination.total || 0)"/>
                        </button>
                        <button
                            type="button"
                            t-foreach="statusOptions"
                            t-as="option"
                            t-key="option.status"
                            t-att-class="state.productFilters.status === option.status ? 'is-active' : ''"
                            t-on-click="() => this.setProductStatus(option.status)"
                        >
                            <span t-esc="statusLabel(option.status)"/>
                            <strong t-esc="formatNumber(option.total)"/>
                        </button>
                    </div>

<div class="o_lqa_retailers_table_head">
                        <div>
                            <h2>Productos publicados</h2>
                            <span>
                                <t t-esc="formatNumber(state.products.pagination.count || 0)"/>
                                visibles de
                                <t t-esc="formatNumber(state.products.pagination.total || 0)"/>
                            </span>
                        </div>
                        <div class="o_lqa_retailers_table_actions">
                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                t-att-disabled="state.downloadingMarketplaceSkus"
                                t-on-click="downloadMarketplaceSkus"
                                title="Descarga sku, listPrice, salePrice y salesChannel del marketplace en Excel"
                            >
                                <i t-att-class="state.downloadingMarketplaceSkus ? 'fa fa-spinner fa-spin' : 'fa fa-download'"/>
                                <t t-if="state.downloadingMarketplaceSkus">Generando...</t>
                                <t t-else="">Descargar pricing</t>
                            </button>
                            <div class="o_lqa_retailers_pager">
                                <button type="button" class="btn btn-secondary" t-att-disabled="!state.products.pagination.has_previous" t-on-click="previousProductsPage">Anterior</button>
                                <span>Pagina <t t-esc="state.products.pagination.page || 1"/></span>
                                <button type="button" class="btn btn-secondary" t-att-disabled="!state.products.pagination.has_next" t-on-click="nextProductsPage">Siguiente</button>
                            </div>
                        </div>
                    </div>

                    <div t-if="state.loadingProducts" class="o_lqa_retailers_empty">
                        Cargando productos del marketplace...
                    </div>
                    <div t-elif="!state.products.items.length" class="o_lqa_retailers_empty">
                        No hay productos para los filtros seleccionados.
                    </div>
                    <div t-else="" class="o_lqa_products_grid">
                        <article
                            t-att-class="productCardClass(product)"
                            t-foreach="state.products.items"
                            t-as="product"
                            t-key="productCardKey(product)"
                            t-on-click="() => this.openProductDetail(product)"
                        >
<div class="o_lqa_product_card__media">
                                <img t-if="product.image" t-att-src="product.image" t-att-alt="product.title"/>
                                <span t-else="" class="o_lqa_product_card__placeholder">Sin imagen</span>
                                <span t-if="product.images_count > 1" class="o_lqa_product_card__gallery">
                                    <i class="fa fa-image"/>
                                    <t t-esc="product.images_count"/>
                                </span>
                            </div>
                            <div class="o_lqa_product_card__body">
                                <div class="o_lqa_product_card__top">
                                    <span
                                        t-att-class="'o_lqa_retailers_badge ' + statusClass(product.status)"
                                        t-esc="statusLabel(product.status)"
                                    />
                                    <small t-esc="product.external_id"/>
                                </div>
                                <h3 t-esc="product.title"/>

                                <div class="o_lqa_product_card__meta">
                                    <span class="o_lqa_product_card__chip is-sku">
                                        <i class="fa fa-barcode"/>
                                        <t t-esc="product.sku || '-'"/>
                                    </span>
                                    <span t-if="product.origin" class="o_lqa_product_card__chip">
                                        <i class="fa fa-globe"/>
                                        <t t-esc="product.origin"/>
                                    </span>
                                    <span t-if="product.market_sku" class="o_lqa_product_card__chip">
                                        <b>Market</b><t t-esc="product.market_sku"/>
                                    </span>
                                </div>

                                <div class="o_lqa_product_card__stats">
                                    <div class="o_lqa_product_card__price">
                                        <s t-if="hasProductListPrice(product)" t-esc="formatCurrency(product.list_price)"/>
                                        <strong t-esc="formatCurrency(productSalePrice(product))"/>
                                    </div>
                                    <span t-att-class="'o_lqa_product_card__stock ' + (product.stock ? 'is-in-stock' : 'is-empty')">
                                        <t t-if="product.stock"><t t-esc="formatNumber(product.stock)"/> en stock</t>
                                        <t t-else="">Sin stock</t>
                                    </span>
                                </div>

                                <div class="o_lqa_product_card__footer">
                                    <small class="o_lqa_product_card__updated" t-esc="formatDateTime(product.last_detected_at)"/>
                                    <a
                                        t-if="product.publication_url"
                                        class="o_lqa_product_card__link"
                                        t-att-href="product.publication_url"
                                        target="_blank"
                                        rel="noreferrer"
                                        t-on-click.stop="() => {}"
                                    >
                                        <i class="fa fa-external-link"/>
                                        Ver publicacion
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

                <section t-if="state.activeTab === 'imports'" class="o_lqa_retailers_panel">
                    <div class="o_lqa_retailers_import_head">
                        <div>
                            <h2>Imports</h2>
                            <span>Sincroniza productos, stock, precios y datos disponibles.</span>
                        </div>
</div>

                    <div t-if="activeImportRun" class="o_lqa_retailers_import_progress">
                        <div class="o_lqa_retailers_import_progress__title">
                            <span
                                t-att-class="'o_lqa_retailers_badge ' + statusClass(activeImportRun.status)"
                                t-esc="statusLabel(activeImportRun.status)"
                            />
                            <div>
                                <h3>Import en ejecucion</h3>
                                <small>
                                    Run
                                    <t t-esc="activeImportRun.id || '-'"/>
                                    desde
                                    <t t-esc="formatDateTime(activeImportRun.started_at)"/>
                                </small>
                            </div>
                        </div>
                        <div class="o_lqa_retailers_import_progress__metrics">
                            <article>
                                <small>Lotes procesados</small>
                                <strong t-esc="formatNumber(activeImportRun.batches_processed)"/>
                            </article>
                            <article>
                                <small>Items procesados</small>
                                <strong t-esc="formatNumber(activeImportRun.items_processed)"/>
                            </article>
                            <article t-att-class="activeImportRun.items_failed ? 'has-error' : ''">
                                <small>Items fallidos</small>
                                <strong t-esc="formatNumber(activeImportRun.items_failed)"/>
                            </article>
                        </div>
                        <div
                            t-att-class="'o_lqa_retailers_import_meter ' + (activeImportRun.total ? '' : 'is-indeterminate')"
                            role="progressbar"
                            t-att-aria-valuenow="importRunProgressPercent(activeImportRun)"
                            aria-valuemin="0"
                            aria-valuemax="100"
                        >
                            <span t-att-style="'width: ' + importRunProgressPercent(activeImportRun) + '%'"/>
                        </div>
                        <small class="o_lqa_retailers_import_progress__caption">
                            <t t-esc="importRunProgressCaption(activeImportRun)"/>
                            <t t-if="activeImportRun.items_failed">
                                ·
                                <t t-esc="formatNumber(activeImportRun.items_failed)"/>
                                fallidos
                            </t>
                        </small>
                    </div>

                    <div class="o_lqa_retailers_table_head">
                        <div>
                            <h2>Historial de ejecuciones</h2>
                            <span>
                                <t t-esc="formatNumber(state.imports.pagination.count || 0)"/>
                                visibles de
                                <t t-esc="formatNumber(state.imports.pagination.total || 0)"/>
                            </span>
                        </div>
                        <div class="o_lqa_retailers_pager">
                            <button type="button" class="btn btn-secondary" t-att-disabled="!state.imports.pagination.has_previous" t-on-click="previousImportsPage">Anterior</button>
                            <span>Pagina <t t-esc="state.imports.pagination.page || 1"/></span>
                            <button type="button" class="btn btn-secondary" t-att-disabled="!state.imports.pagination.has_next" t-on-click="nextImportsPage">Siguiente</button>
                        </div>
                    </div>

                    <div t-if="state.loadingImports" class="o_lqa_retailers_empty">
                        Cargando historial de imports...
                    </div>
                    <div t-elif="!state.imports.items.length" class="o_lqa_retailers_empty">
                        Todavia no hay ejecuciones registradas.
                    </div>
                    <div t-else="" class="o_lqa_retailers_table_wrap">
                        <table class="o_lqa_retailers_table">
                            <thead>
                                <tr>
                                    <th>Run</th>
                                    <th>Estado</th>
                                    <th>Progreso</th>
                                    <th>Lotes</th>
                                    <th>Procesados</th>
                                    <th>Fallidos</th>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.imports.items" t-as="run" t-key="run.id || run.started_at">
                                    <td>
                                        <strong t-esc="run.id || '-'"/>
                                        <small t-esc="run.marketplace"/>
                                    </td>
                                    <td>
                                        <span
                                            t-att-class="'o_lqa_retailers_badge ' + statusClass(run.status)"
                                            t-esc="statusLabel(run.status)"
                                        />
                                    </td>
                                    <td>
                                        <strong>
                                            <t t-esc="run.progress !== null &amp;&amp; run.progress !== undefined ? run.progress : '-'"/>
                                            <t t-if="run.progress !== null &amp;&amp; run.progress !== undefined">%</t>
                                        </strong>
                                        <small t-esc="importRunProgressCaption(run)"/>
                                    </td>
                                    <td t-esc="formatNumber(run.batches_processed)"/>
                                    <td t-esc="formatNumber(run.items_processed)"/>
                                    <td>
                                        <span
                                            t-att-class="'o_lqa_retailers_badge ' + (run.items_failed ? 'is-red' : 'is-green')"
                                            t-esc="formatNumber(run.items_failed)"
                                        />
                                    </td>
                                    <td t-esc="formatDateTime(run.started_at)"/>
                                    <td t-esc="formatDateTime(run.finished_at)"/>
                                    <td>
                                        <small t-esc="run.message || '-'"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section t-if="state.activeTab === 'status'" class="o_lqa_retailers_panel">
                    <div class="o_lqa_retailers_status_head">
                        <div>
                            <h2>Status de publicaciones</h2>
                            <span>Distribucion de estados del marketplace.</span>
                        </div>
                        <strong>
                            <t t-esc="formatNumber(state.status.total || 0)"/>
                            publicaciones
                        </strong>
                    </div>

                    <div t-if="state.loadingStatus" class="o_lqa_retailers_empty">
                        Cargando status del marketplace...
                    </div>
                    <div t-elif="!state.status.statuses.length" class="o_lqa_retailers_empty">
                        No hay status disponibles.
                    </div>
                    <div t-else="" class="o_lqa_status_grid">
                        <article
                            t-foreach="state.status.statuses"
                            t-as="status"
                            t-key="status.status"
                        >
                            <div>
                                <span
                                    t-att-class="'o_lqa_retailers_badge ' + statusClass(status.status)"
                                    t-esc="statusLabel(status.status)"
                                />
                                <strong t-esc="formatNumber(status.count)"/>
                            </div>
                            <div class="o_lqa_status_bar">
                                <span t-att-style="'width: ' + (status.percentage || 0) + '%;'"/>
                            </div>
                            <small>
                                <t t-esc="status.percentage || 0"/>%
                            </small>
                        </article>
                    </div>
                </section>
            </section>

<div class="o_lqa_modal_backdrop" t-if="state.productDetail" t-on-click="closeProductDetail">
                <div class="o_lqa_product_detail_modal" t-on-click.stop="() => {}">
                    <button
                        type="button"
                        class="o_lqa_product_detail_modal__close"
                        t-on-click="closeProductDetail"
                        aria-label="Cerrar"
                    >
                        <i class="fa fa-times"/>
                    </button>

                    <div class="o_lqa_product_detail_modal__gallery">
                        <div class="o_lqa_product_detail_modal__main_image">
                            <img
                                t-if="productDetailImages(state.productDetail).length"
                                t-att-src="productDetailImages(state.productDetail)[0]"
                                t-att-alt="state.productDetail.title"
                            />
                            <span t-else="" class="o_lqa_product_card__placeholder">Sin imagen</span>
                        </div>
                        <div
                            t-if="productDetailImages(state.productDetail).length > 1"
                            class="o_lqa_product_detail_modal__thumbs"
                        >
                            <img
                                t-foreach="productDetailImages(state.productDetail)"
                                t-as="detail_image"
                                t-key="detail_image"
                                t-att-src="detail_image"
                                t-att-alt="state.productDetail.title"
                            />
                        </div>
                    </div>

                    <div class="o_lqa_product_detail_modal__info">
                        <div class="o_lqa_product_card__top">
                            <span
                                t-att-class="'o_lqa_retailers_badge ' + statusClass(state.productDetail.status)"
                                t-esc="statusLabel(state.productDetail.status)"
                            />
                            <small t-esc="state.productDetail.external_id"/>
                        </div>

                        <h2 t-esc="state.productDetail.title"/>
                        <p
                            t-if="state.productDetail.details.subtitle"
                            class="o_lqa_product_detail_modal__subtitle"
                            t-esc="state.productDetail.details.subtitle"
                        />

                        <div class="o_lqa_product_card__stats">
                            <div class="o_lqa_product_card__price">
                                <s
                                    t-if="hasProductListPrice(state.productDetail)"
                                    t-esc="formatCurrency(state.productDetail.list_price)"
                                />
                                <strong t-esc="formatCurrency(productSalePrice(state.productDetail))"/>
                            </div>
                            <span
                                t-att-class="'o_lqa_product_card__stock ' + (state.productDetail.stock ? 'is-in-stock' : 'is-empty')"
                            >
                                <t t-if="state.productDetail.stock">
                                    <t t-esc="formatNumber(state.productDetail.stock)"/> en stock
                                </t>
                                <t t-else="">Sin stock</t>
                            </span>
                        </div>

                        <dl class="o_lqa_product_detail_modal__grid">
                            <div>
                                <dt>SKU</dt>
                                <dd t-esc="state.productDetail.sku || '-'"/>
                            </div>
                            <div t-if="state.productDetail.market_sku">
                                <dt>Market SKU</dt>
                                <dd t-esc="state.productDetail.market_sku"/>
                            </div>
                            <div t-if="state.productDetail.details.ean">
                                <dt>EAN</dt>
                                <dd t-esc="state.productDetail.details.ean"/>
                            </div>
                            <div t-if="state.productDetail.origin">
                                <dt>Origen</dt>
                                <dd t-esc="state.productDetail.origin"/>
                            </div>
                            <div t-if="state.productDetail.details.category">
                                <dt>Categoria</dt>
                                <dd t-esc="state.productDetail.details.category"/>
                            </div>
                            <div t-if="state.productDetail.details.brand">
                                <dt>Marca</dt>
                                <dd t-esc="state.productDetail.details.brand"/>
                            </div>
                            <div t-if="state.productDetail.details.seller_id">
                                <dt>Seller ID</dt>
                                <dd t-esc="state.productDetail.details.seller_id"/>
                            </div>
                            <div t-if="productDimensionsLabel(state.productDetail)">
                                <dt>Dimensiones</dt>
                                <dd t-esc="productDimensionsLabel(state.productDetail)"/>
                            </div>
                            <div t-if="state.productDetail.details.net_price">
                                <dt>Precio neto</dt>
                                <dd t-esc="formatCurrency(state.productDetail.details.net_price)"/>
                            </div>
                            <div t-if="state.productDetail.details.status_message">
                                <dt>Estado origen</dt>
                                <dd t-esc="state.productDetail.details.status_message"/>
                            </div>
                            <div>
                                <dt>Ultima deteccion</dt>
                                <dd t-esc="formatDateTime(state.productDetail.last_detected_at)"/>
                            </div>
                        </dl>

                        <div
                            t-if="state.productDetail.details.stock_by_warehouse.length"
                            class="o_lqa_product_detail_modal__warehouses"
                        >
                            <h3>Stock por deposito</h3>
                            <div
                                t-foreach="state.productDetail.details.stock_by_warehouse"
                                t-as="warehouse"
                                t-key="warehouse.warehouse_id"
                            >
                                <span t-esc="warehouse.warehouse_id"/>
                                <strong t-esc="formatNumber(warehouse.quantity)"/>
                            </div>
                        </div>

                        <div
                            t-if="state.productDetail.details.description"
                            class="o_lqa_product_detail_modal__description"
                        >
                            <h3>Descripcion</h3>
                            <p t-esc="state.productDetail.details.description"/>
                        </div>

                        <div class="o_lqa_retailers_modal__actions">
                            <a
                                t-if="state.productDetail.publication_url"
                                class="btn btn-primary"
                                t-att-href="state.productDetail.publication_url"
                                target="_blank"
                                rel="noreferrer"
                            >
                                <i class="fa fa-external-link"/>
                                Ver publicacion
                            </a>
                            <button type="button" class="btn btn-secondary" t-on-click="closeProductDetail">
                                Cerrar
