<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Antes: overlay a pantalla completa con blur y "Cargando", que tapaba
         la vista con cualquier llamada al servidor (filtrar, paginar, el
         polling de Seguimiento). Ahora una linea fina arriba que no bloquea. -->
    <t
        t-name="lqa_admin_panel.LoadingIndicator"
        t-inherit="web.LoadingIndicator"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//span[contains(concat(' ', normalize-space(@class), ' '), ' o_loading_indicator ')]"
            position="replace"
        >
            <span
                class="o_loading_indicator"
                t-att-class="transition.className"
                role="status"
                aria-live="polite"
            >
                <span class="visually-hidden">Cargando</span>
            </span>
        </xpath>
    </t>
</templates>
